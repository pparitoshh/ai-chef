# Groq API key — get it free at https://console.groq.com/keys
GROQ_API_KEY=

# Kaggle credentials (only if dataset download requires auth)
# https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face token (optional; removes rate-limit warnings on model downloads)
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Postgres (matches docker-compose; localhost when running outside docker)
POSTGRES_HOST=localhost
POSTGRES_DB=ai_chef
POSTGRES_USER=chef
POSTGRES_PASSWORD=chef

# Models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Data
DATA_PATH=data/recipes_10k.csv
