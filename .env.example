# Groq API key — get it free at https://console.groq.com/keys
GROQ_API_KEY=

# Kaggle credentials (only if dataset download requires auth)
# https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Postgres (matches docker-compose; localhost when running outside docker)
POSTGRES_HOST=localhost
POSTGRES_DB=ai_chef
POSTGRES_USER=chef
POSTGRES_PASSWORD=chef

# Models
GROQ_MODEL=llama-3.1-8b-instant
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Data
DATA_PATH=data/recipes_10k.csv
